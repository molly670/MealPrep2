      function scaleMeasurementLine(line, servings) {
        if (servings === 2) return line;
        const factor = servings / 2;
        return line.replace(/(\d+(?:\.\d+)?)\s*(cups?|cup|g|kg|tbsp|tsp|pieces?|pcs|eggs?|potatoes?|onions?|കപ്പ്|മുട്ട|ഉരുളക്കിഴങ്ങ്|ഉള്ളി|ടേബിൾസ്പൂൺ|ടീസ്പൂൺ)/gi, (match, numStr, unit) => {
          const val = parseFloat(numStr) * factor;
          const formatted = Number.isInteger(val) ? String(val) : val.toFixed(1).replace(/\.0$/, '');
          return `${formatted} ${unit}`;
        });
      }


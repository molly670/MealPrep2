      function getStrictlyMatchedDishes() {
        const activeIngredients = state.selectedIngredients.filter((id) => {
          const allBuiltIn = [...BUILTIN_INGREDIENTS.grains, ...BUILTIN_INGREDIENTS.protein, ...BUILTIN_INGREDIENTS.veg];
          const foundBuiltIn = allBuiltIn.find((x) => x.id === id);
          if (foundBuiltIn) return isIngredientAllowedByDietToggle(foundBuiltIn);
          const foundCust = state.customItems.find((x) => x.id === id);
          if (foundCust) return isIngredientAllowedByDietToggle(foundCust);
          return true;
        });

        if (activeIngredients.length === 0) return [];
        const selectedSet = new Set(activeIngredients);

        return DISH_CATALOG
          .filter((dish) => {
            const regionOk = state.region === 'all' || dish.region === state.region || dish.region === 'all';
            const canMake = dish.req.every((reqId) => selectedSet.has(reqId));
            const dietOk = isDishAllowedByDietToggle(dish);
            return regionOk && canMake && dietOk;
          })
          .sort((a, b) => b.req.length - a.req.length);
      }


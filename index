      function validateHealthConditionInput(rawInput) {
        const useMl = state.lang === 'ml';
        const cleaned = rawInput.trim().replace(/\s+/g, ' ');
        const lower = cleaned.toLowerCase();

        const blockedWords = [
          'dead', 'death', 'die', 'dying', 'zombie', 'ghost', 'murder', 'kill',
          'test', 'testing', 'abc', 'abcd', 'xyz', 'qwerty', 'asdf', 'zxcv',
          'hello', 'hi', 'hey', 'lol', 'haha', 'ok', 'yes', 'no', 'none', 'nothing',
          'idk', 'random', 'blah', 'foo', 'bar', 'dummy', 'fake', 'nil', 'null',
          'nan', 'undefined', 'chair', 'table', 'car', 'bike', 'phone', 'stone', 'wall'
        ];

        if (cleaned.length < 3 || cleaned.length > 40) {
          return {
            valid: false,
            error: useMl
              ? '⚠️ ദയവായി ശരിയായ ഒരു ആരോഗ്യപ്രശ്നം നൽകുക (ഉദാ: PCOS, Fatty Liver, Anemia).'
              : '⚠️ Please enter a valid health condition (e.g., PCOS, Fatty Liver, Anemia).'
          };
        }

        if (!/[a-zA-Z\u0900-\u0D7F]/.test(cleaned) || /[0-9@#$%^&*=+<>~`]/.test(cleaned)) {
          return {
            valid: false,
            error: useMl
              ? '⚠️ അക്കങ്ങളോ ചിഹ്നങ്ങളോ പാടില്ല. ശരിയായ രോഗാവസ്ഥയുടെ പേര് നൽകുക (ഉദാ: PCOS, Anemia).'
              : '⚠️ Numbers or symbols are not allowed. Enter a real health condition (e.g., PCOS, Anemia).'
          };
        }

        if (blockedWords.includes(lower)) {
          return {
            valid: false,
            error: useMl
              ? `⚠️ "${cleaned}" എന്നത് ഒരു ആരോഗ്യപ്രശ്നമല്ല. ദയവായി ശരിയായ രോഗാവസ്ഥ നൽകുക (ഉദാ: PCOS, Fatty Liver, Anemia).`
              : `⚠️ "${cleaned}" is not a valid medical condition. Please enter a real health condition (e.g., PCOS, Fatty Liver, Anemia).`
          };
        }

        if (/(.)\1{2,}/i.test(lower)) {
          return {
            valid: false,
            error: useMl
              ? '⚠️ അക്ഷരത്തെറ്റുണ്ട്. ദയവായി ശരിയായ ആരോഗ്യപ്രശ്നം നൽകുക (ഉദാ: Fatty Liver, Uric Acid).'
              : '⚠️ That looks like a random word. Please enter a valid health condition (e.g., Fatty Liver, Uric Acid).'
          };
        }

        if (/^[a-zA-Z\s]+$/.test(lower)) {
          const words = lower.split(' ');
          const hasGibberishWord = words.some((w) => {
            if (w.length >= 4 && !/[aeiouy]/i.test(w)) return true;
            if (/[bcdfghjklmnpqrstvwxz]{5,}/i.test(w)) return true;
            return false;
          });
          if (hasGibberishWord) {
            return {
              valid: false,
              error: useMl
                ? `⚠️ "${cleaned}" വ്യക്തമല്ല. ദയവായി ശരിയായ രോഗാവസ്ഥ നൽകുക (ഉദാ: PCOS, Anemia, Uric Acid).`
                : `⚠️ "${cleaned}" doesn't look like a valid health condition. Try PCOS, Anemia, or Uric Acid.`
            };
          }
        }

        const alreadyBuiltIn = HEALTH_CONDITIONS_DB.some(
          (c) => c.en.toLowerCase().includes(lower) || c.id === lower
        );
        const alreadyCustom = state.customConditions.some(
          (c) => c.toLowerCase() === lower
        );
        if (alreadyBuiltIn || alreadyCustom) {
          return {
            valid: false,
            error: useMl
              ? `ℹ️ "${cleaned}" ഇതിനകം ലിസ്റ്റിൽ ചേർത്തിട്ടുണ്ട്.`
              : `ℹ️ "${cleaned}" is already added to your health list.`
          };
        }

        const matchedMed = VALID_MEDICAL_CONDITIONS.find((m) =>
          m.keys.some((k) => lower.includes(k))
        );

        return {
          valid: true,
          normalizedName: matchedMed ? matchedMed.label : cleaned.replace(/\b\w/g, (ch) => ch.toUpperCase())
        };
      }


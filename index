<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#0F766E" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%230F766E'/%3E%3Ctext x='50' y='68' font-size='56' text-anchor='middle'%3E%F0%9F%8D%B2%3C/text%3E%3C/svg%3E" />
  <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%230F766E'/%3E%3Ctext x='50' y='68' font-size='56' text-anchor='middle'%3E%F0%9F%8D%B2%3C/text%3E%3C/svg%3E" />
  <title>MealPrep — Indian Meal &amp; Healthy Diet Planner</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Bengali:wght@400;600;700&family=Noto+Sans+Devanagari:wght@400;600;700&family=Noto+Sans+Gujarati:wght@400;600;700&family=Noto+Sans+Gurmukhi:wght@400;600;700&family=Noto+Sans+Kannada:wght@400;600;700&family=Noto+Sans+Malayalam:wght@400;600;700;800&family=Noto+Sans+Oriya:wght@400;600;700&family=Noto+Sans+Tamil:wght@400;600;700&family=Noto+Sans+Telugu:wght@400;600;700&display=swap" rel="stylesheet" />
  <script>
    if (window.tailwind) {
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: [
                'Inter',
                'Noto Sans Malayalam',
                'Noto Sans Devanagari',
                'Noto Sans Tamil',
                'Noto Sans Telugu',
                'Noto Sans Kannada',
                'Noto Sans Bengali',
                'Noto Sans Gujarati',
                'Noto Sans Gurmukhi',
                'Noto Sans Oriya',
                'system-ui',
                'sans-serif'
              ]
            }
          }
        }
      };
    }
  </script>
  <style>
    body {
      background: linear-gradient(135deg, #CCFBF1 0%, #F0FDFA 42%, #FEF3C7 100%);
      color: #132A28;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      margin: 0;
    }
    input, select, textarea { user-select: text; }
    .app-shell {
      max-width: 520px;
      margin: 0 auto;
      min-height: 100vh;
      background: linear-gradient(180deg, #F4FBF9 0%, #FAF8F5 50%, #FFF7ED 100%);
      position: relative;
      padding-bottom: calc(105px + env(safe-area-inset-bottom, 0px));
    }
    .safe-header {
      padding-top: calc(0.875rem + env(safe-area-inset-top, 0px));
    }
    .safe-bottom-nav {
      padding-bottom: calc(0.875rem + env(safe-area-inset-bottom, 0px));
    }
    .hidden { display: none !important; }
    @media (min-width: 640px) {
      body {
        background: radial-gradient(circle at top left, #99F6E4 0%, #E0F2FE 45%, #FDE68A 100%);
        padding: 16px 0;
      }
      .app-shell {
        min-height: calc(100vh - 32px);
        border: 2px solid #5EEAD4;
        border-radius: 36px;
        box-shadow: 0 28px 65px -12px rgba(15, 118, 110, 0.25), 0 10px 28px -6px rgba(217, 119, 6, 0.14);
        overflow-x: hidden;
      }
    }
    .culinary-card {
      background: #FFFFFF;
      border: 1.5px solid #CCFBF1;
      box-shadow: 0 12px 28px -8px rgba(15, 118, 110, 0.12);
    }
    .grain-card {
      background: linear-gradient(145deg, #F0FDFA 0%, #FFFFFF 100%);
      border: 1.5px solid #5EEAD4;
      box-shadow: 0 10px 24px -6px rgba(13, 148, 136, 0.14);
    }
    .protein-card {
      background: linear-gradient(145deg, #FFE4E6 0%, #FFF1F2 55%, #FFFFFF 100%);
      border: 1.5px solid #FDA4AF;
      box-shadow: 0 10px 24px -6px rgba(225, 29, 72, 0.14);
    }
    .veg-card {
      background: linear-gradient(145deg, #F5F3FF 0%, #FFFFFF 100%);
      border: 1.5px solid #C4B5FD;
      box-shadow: 0 10px 24px -6px rgba(124, 58, 237, 0.14);
    }
    .hero-banner-pattern {
      background-image: radial-gradient(rgba(255, 255, 255, 0.16) 1.5px, transparent 1.5px);
      background-size: 14px 14px;
    }
    .tab-panel {
      display: none;
      animation: slideUp 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .tab-panel.active {
      display: block;
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes splashPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.06); }
    }
    @keyframes splashBar {
      0% { width: 0%; }
      100% { width: 100%; }
    }
    .splash-logo-anim {
      animation: splashPulse 1.3s ease-in-out infinite;
    }
    .splash-progress-fill {
      animation: splashBar 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    #appSplashScreen {
      cursor: pointer;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    #appSplashScreen.splash-hide {
      opacity: 0;
      transform: scale(1.02);
      pointer-events: none;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .pressable:active { transform: scale(0.97); }
  </style>
</head>
<body class="font-sans antialiased">

  <!-- APP LAUNCH SPLASH SCREEN (TAP ANYWHERE TO ENTER IMMEDIATELY) -->
  <div
    id="appSplashScreen"
    onclick="dismissSplashNow()"
    ontouchstart="dismissSplashNow()"
    role="button"
    tabindex="0"
    aria-label="Tap to enter MealPrep"
    class="fixed inset-0 z-50 bg-gradient-to-br from-teal-900 via-teal-800 to-emerald-900 flex flex-col items-center justify-center p-6 text-white text-center select-none"
  >
    <div class="splash-logo-anim w-24 h-24 rounded-3xl bg-gradient-to-tr from-amber-400 via-orange-400 to-yellow-300 p-1 shadow-2xl mb-5">
      <div class="w-full h-full rounded-[22px] bg-teal-950 flex items-center justify-center text-5xl">
        🍲
      </div>
    </div>
    <h1 class="text-3xl font-extrabold tracking-tight text-white">MealPrep</h1>
    <p class="text-xs sm:text-sm font-semibold text-teal-200 mt-1.5 tracking-wide">
      Indian Kitchen, Desi Recipes &amp; Healthy Diet
    </p>
    <div class="w-48 h-1.5 rounded-full bg-teal-950/70 overflow-hidden mt-6 border border-teal-600/40">
      <div class="splash-progress-fill h-full rounded-full bg-gradient-to-r from-amber-400 to-emerald-400"></div>
    </div>
    <span class="mt-4 px-4 py-1.5 rounded-full bg-white/15 border border-white/25 text-amber-200 text-xs font-extrabold tracking-wide">
      Tap anywhere to enter &rarr;
    </span>
  </div>

  <div class="app-shell flex flex-col">

    <!-- TOP STICKY HEADER -->
    <header class="safe-header sticky top-0 z-40 bg-gradient-to-r from-teal-800 via-teal-700 to-emerald-700 text-white border-b border-teal-600/50 px-4 pb-3.5 flex items-center justify-between gap-2 shadow-md">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-amber-400 via-orange-400 to-yellow-300 p-[2px] shadow-md shrink-0">
          <div class="w-full h-full rounded-[14px] bg-teal-950 flex items-center justify-center text-lg">
            🍲
          </div>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <h1 class="text-base font-extrabold tracking-tight text-white truncate">
              MealPrep
            </h1>
            <span id="proHeaderBadge" class="hidden px-1.5 py-0.5 rounded-md bg-amber-400 text-teal-950 text-[9px] font-extrabold uppercase tracking-wider">
              PRO
            </span>
          </div>
          <p id="headerSubtitle" class="text-[10.5px] font-medium text-teal-100 truncate">
            Indian Meal &amp; Healthy Diet Planner
          </p>
        </div>
      </div>

      <div class="flex items-center gap-1.5 shrink-0">
        <!-- Pro Upgrade Trigger Button -->
        <button
          id="openProModalBtn"
          type="button"
          class="pressable px-2.5 py-1 rounded-full bg-gradient-to-r from-amber-400 to-orange-400 text-teal-950 text-[11px] font-extrabold flex items-center gap-1 shadow-xs"
        >
          <span>👑</span>
          <span id="proHeaderBtnText">Pro ₹49</span>
        </button>

        <!-- Symbol-Only Help (?) Button -->
        <button
          id="openFtueBtn"
          type="button"
          aria-label="Help & Guide"
          title="Help & Guide"
          class="pressable w-8 h-8 rounded-full bg-amber-400/20 hover:bg-amber-400/35 border border-amber-300/60 text-amber-200 text-sm font-extrabold flex items-center justify-center transition shadow-2xs"
        >
          ?
        </button>

        <div class="relative">
          <select
            id="langSelect"
            aria-label="Select Indian Language"
            class="appearance-none bg-white/15 hover:bg-white/25 backdrop-blur-md border border-white/30 text-white text-[11px] font-extrabold rounded-full pl-2.5 pr-6 py-1.5 focus:outline-none cursor-pointer shadow-sm"
          >
            <option value="en" class="text-stone-900">English</option>
            <option value="ml" class="text-stone-900">മലയാളം</option>
            <option value="hi" class="text-stone-900">हिन्दी</option>
            <option value="ta" class="text-stone-900">தமிழ்</option>
            <option value="te" class="text-stone-900">తెలుగు</option>
            <option value="kn" class="text-stone-900">ಕನ್ನಡ</option>
            <option value="bn" class="text-stone-900">বাংলা</option>
            <option value="mr" class="text-stone-900">मराठी</option>
            <option value="gu" class="text-stone-900">ગુજરાતી</option>
            <option value="pa" class="text-stone-900">ਪੰਜਾਬੀ</option>
            <option value="or" class="text-stone-900">ଓଡ଼ିଆ</option>
            <option value="as" class="text-stone-900">অসমীয়া</option>
          </select>
          <span class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-[9px] text-amber-300">▼</span>
        </div>
      </div>
    </header>

    <!-- TOAST SNACKBAR -->
    <div id="snackbar" class="hidden mx-4 mt-3 rounded-2xl px-4 py-3 text-xs font-bold flex items-center justify-between gap-3 border shadow-sm">
      <span id="snackbarText"></span>
      <button type="button" id="closeSnackbarBtn" class="text-[11px] uppercase underline shrink-0">OK</button>
    </div>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 px-4 pt-4 pb-6 space-y-4">

      <!-- =================================================================== -->
      <!-- TAB 1: KITCHEN / അടുക്കള                                            -->
      <!-- =================================================================== -->
      <section id="panel-fridge" class="tab-panel active space-y-4">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-700 via-purple-700 to-fuchsia-600 hero-banner-pattern p-4 text-white shadow-lg shadow-indigo-900/20">
          <div class="flex items-center justify-between gap-3">
            <div class="space-y-1 min-w-0">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-white/15 text-[10px] font-extrabold uppercase tracking-wider text-amber-200">
                ✨ Smart Indian Kitchen
              </span>
              <h2 id="fridgeTitle" class="text-base sm:text-lg font-extrabold text-white leading-snug">What's in your kitchen today?</h2>
              <p id="fridgeSub" class="text-[11.5px] text-indigo-100 leading-relaxed">
                Tap items or type Desi names (e.g., Atta, Murgh, Meen, Dahi) via + Add.
              </p>
            </div>
            <div class="w-20 h-20 shrink-0 rounded-2xl bg-white/15 backdrop-blur-sm border border-white/25 flex items-center justify-center p-1.5 shadow-inner">
              <svg viewBox="0 0 80 80" class="w-full h-full drop-shadow">
                <circle cx="40" cy="42" r="32" fill="#FDE68A" stroke="#F59E0B" stroke-width="3" />
                <circle cx="40" cy="42" r="26" fill="#FFFBEB" />
                <circle cx="32" cy="47" r="11" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1.5" />
                <circle cx="30" cy="44" r="1.3" fill="#10B981" />
                <circle cx="34" cy="48" r="1.3" fill="#F59E0B" />
                <circle cx="50" cy="34" r="8" fill="#F97316" stroke="#EA580C" stroke-width="1.5" />
                <circle cx="50" cy="34" r="5.5" fill="#FBBF24" />
                <circle cx="50" cy="52" r="7.5" fill="#059669" stroke="#047857" stroke-width="1.5" />
                <circle cx="48" cy="51" r="2" fill="#6EE7B7" />
                <circle cx="52" cy="53" r="1.8" fill="#A7F3D0" />
                <path d="M24 27 Q31 20 38 27 Q31 32 24 27 Z" fill="#10B981" />
              </svg>
            </div>
          </div>

          <div class="flex items-center justify-between gap-2 mt-3 pt-2.5 border-t border-white/15">
            <span id="selectedCounterBadge" class="px-3 py-1 rounded-xl bg-white text-teal-900 text-xs font-extrabold shadow-xs">
              5 Selected
            </span>
            <button
              id="clearAllItemsBtn"
              type="button"
              class="pressable px-3 py-1 rounded-xl bg-white/15 hover:bg-white/25 border border-white/25 text-white text-[11px] font-bold"
            >
              Clear
            </button>
          </div>
        </div>

        <!-- Mutually Exclusive Veg <-> Non-Veg Toggle + Separate Dairy Toggle -->
        <div class="culinary-card rounded-2xl p-3 space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <span id="dietToggleHeading" class="text-[11px] font-extrabold uppercase tracking-wider text-teal-800">
              🍽️ Diet Mode &amp; Dairy Toggle
            </span>
            <span id="dietToggleSummary" class="text-[10.5px] font-bold text-stone-500">
              Non-Veg + Dairy
            </span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex-1 grid grid-cols-2 p-1 rounded-xl bg-stone-100 border border-stone-200 gap-1">
              <button
                type="button"
                id="toggleVegBtn"
                class="pressable py-1.5 px-2 rounded-lg text-xs font-extrabold flex items-center justify-center gap-1 transition"
              >
                <span>🟢</span>
                <span id="toggleVegText">Pure Veg</span>
              </button>
              <button
                type="button"
                id="toggleNonVegBtn"
                class="pressable py-1.5 px-2 rounded-lg text-xs font-extrabold flex items-center justify-center gap-1 transition"
              >
                <span>🍗</span>
                <span id="toggleNonVegText">Non-Veg</span>
              </button>
            </div>

            <button
              type="button"
              id="toggleDairyBtn"
              class="pressable py-2 px-3 rounded-xl border text-xs font-extrabold flex items-center justify-center gap-1.5 shrink-0 transition"
            >
              <span>🥛</span>
              <span id="toggleDairyText">Dairy: ON</span>
            </button>
          </div>
        </div>

        <!-- Friendly Guardrail Reminder Box -->
        <div id="dietGuardrailAlert" class="hidden rounded-2xl bg-amber-50 border-2 border-amber-400 p-3 text-xs font-bold text-amber-950 flex items-start justify-between gap-2.5 shadow-xs">
          <div class="space-y-1.5">
            <p id="dietGuardrailText" class="leading-relaxed"></p>
            <button
              type="button"
              id="dietGuardrailSwitchBtn"
              class="pressable inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-[11px] font-extrabold shadow-2xs"
            >
              Switch Mode Now
            </button>
          </div>
          <button type="button" id="dismissDietGuardrailBtn" class="text-xs underline text-amber-800 shrink-0">OK</button>
        </div>

        <!-- Category 1: Grains -->
        <div class="grain-card rounded-3xl p-4 space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-xl bg-teal-600 text-white flex items-center justify-center text-sm shadow-2xs">🌾</span>
              <span id="catGrainsLabel" class="text-xs font-extrabold uppercase tracking-wider text-teal-900">
                Staples &amp; Grains (Rice / Atta / Maida)
              </span>
            </div>
            <button
              type="button"
              data-toggle-cat-add="grains"
              class="pressable inline-flex items-center gap-1 px-3 py-1 rounded-full bg-teal-600 hover:bg-teal-700 text-white text-[11px] font-extrabold shadow-xs"
            >
              + Add
            </button>
          </div>
          <form data-cat-add-form="grains" class="hidden flex items-center gap-2 pt-1">
            <input
              type="text"
              placeholder="Desi or English name (e.g., Ari, Gothambu, Rava, Ragi)..."
              class="flex-1 min-w-0 rounded-xl bg-white border border-teal-400 px-3 py-2 text-xs text-stone-900 placeholder-stone-400 focus:outline-none"
            />
            <button type="submit" class="pressable px-3.5 py-2 rounded-xl bg-teal-600 text-white font-extrabold text-xs shrink-0 shadow">
              ✓
            </button>
          </form>
          <div id="chips-grains" class="flex flex-wrap gap-2"></div>
        </div>

        <!-- Category 2: Proteins -->
        <div class="protein-card rounded-3xl p-4 space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-xl bg-rose-600 text-white flex items-center justify-center text-sm shadow-2xs">🥚</span>
              <span id="catProteinLabel" class="text-xs font-extrabold uppercase tracking-wider text-rose-950">
                Proteins (Dal / Eggs / Chicken / Fish / Dairy)
              </span>
            </div>
            <button
              type="button"
              data-toggle-cat-add="protein"
              class="pressable inline-flex items-center gap-1 px-3 py-1 rounded-full bg-rose-600 hover:bg-rose-700 text-white text-[11px] font-extrabold shadow-xs"
            >
              + Add
            </button>
          </div>
          <form data-cat-add-form="protein" class="hidden flex items-center gap-2 pt-1">
            <input
              type="text"
              placeholder="Desi name (e.g., Murgh, Meen, Mutta, Dahi, Parippu)..."
              class="flex-1 min-w-0 rounded-xl bg-white border border-rose-400 px-3 py-2 text-xs text-stone-900 placeholder-stone-400 focus:outline-none"
            />
            <button type="submit" class="pressable px-3.5 py-2 rounded-xl bg-rose-600 text-white font-extrabold text-xs shrink-0 shadow">
              ✓
            </button>
          </form>
          <div id="chips-protein" class="flex flex-wrap gap-2"></div>
        </div>

        <!-- Category 3: Vegetables -->
        <div class="veg-card rounded-3xl p-4 space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-xl bg-violet-600 text-white flex items-center justify-center text-sm shadow-2xs">🥬</span>
              <span id="catVegLabel" class="text-xs font-extrabold uppercase tracking-wider text-violet-900">
                Vegetables &amp; Coconut
              </span>
            </div>
            <button
              type="button"
              data-toggle-cat-add="veg"
              class="pressable inline-flex items-center gap-1 px-3 py-1 rounded-full bg-violet-600 hover:bg-violet-700 text-white text-[11px] font-extrabold shadow-xs"
            >
              + Add
            </button>
          </div>
          <form data-cat-add-form="veg" class="hidden flex items-center gap-2 pt-1">
            <input
              type="text"
              placeholder="Desi name (e.g., Thenga, Aloo, Vendakka, Palak)..."
              class="flex-1 min-w-0 rounded-xl bg-white border border-violet-400 px-3 py-2 text-xs text-stone-900 placeholder-stone-400 focus:outline-none"
            />
            <button type="submit" class="pressable px-3.5 py-2 rounded-xl bg-violet-600 text-white font-extrabold text-xs shrink-0 shadow">
              ✓
            </button>
          </form>
          <div id="chips-veg" class="flex flex-wrap gap-2"></div>
        </div>

        <!-- Live Health Condition Advisory Alert -->
        <div id="kitchenHealthAlertBox" class="hidden rounded-2xl bg-rose-50 border border-rose-300 p-3.5 space-y-1.5 shadow-xs">
          <div class="flex items-center justify-between gap-2">
            <span id="kitchenHealthAlertTitle" class="text-xs font-extrabold text-rose-700">🩺 Health Tip</span>
            <button type="button" id="kitchenGoDietBtn" class="text-[11px] font-extrabold text-teal-700 underline">
              Diet Guide &rarr;
            </button>
          </div>
          <p id="kitchenHealthAlertBody" class="text-xs text-stone-700 leading-relaxed"></p>
        </div>

        <button
          id="generatePlanBtn"
          type="button"
          class="pressable w-full py-4 px-5 rounded-2xl bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 text-white font-extrabold text-sm shadow-lg shadow-orange-600/25 flex items-center justify-center gap-2"
        >
          <span id="generatePlanBtnText">See Matching Meals</span>
          <span class="text-base">&rarr;</span>
        </button>
      </section>

      <!-- =================================================================== -->
      <!-- TAB 2: MEALS / കോമ്പോ                                              -->
      <!-- =================================================================== -->
      <section id="panel-combo" class="tab-panel space-y-4">
        <div class="rounded-3xl bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 hero-banner-pattern p-4 text-white shadow-md flex items-center justify-between gap-2">
          <div class="min-w-0">
            <h2 id="comboTitle" class="text-base sm:text-lg font-extrabold text-white">Matching Meals</h2>
            <p id="comboSub" class="text-[11.5px] text-amber-50 mt-0.5">
              Dosa, Chapati, Kerala Porotta, custom &amp; Indian dishes.
            </p>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <button

      function updateKitchenHealthAdvisory() {
        const box = document.getElementById('kitchenHealthAlertBox');
        const body = document.getElementById('kitchenHealthAlertBody');
        const useMl = state.lang === 'ml';

        if (state.selectedConditions.length === 0) {
          box.classList.add('hidden');
          return;
        }

        const warnings = [];
        state.selectedConditions.forEach((cid) => {
          const cond = HEALTH_CONDITIONS_DB.find((c) => c.id === cid);
          if (!cond) return;
          const flagged = cond.avoidIds.filter((id) => state.selectedIngredients.includes(id));
          if (flagged.length > 0) {
            const names = flagged.map((fid) => {
              const all = [...BUILTIN_INGREDIENTS.grains, ...BUILTIN_INGREDIENTS.protein, ...BUILTIN_INGREDIENTS.veg];
              const found = all.find((x) => x.id === fid);
              return found ? (found.names[state.lang] || found.names.en) : fid;
            }).join(', ');
            warnings.push(
              useMl
                ? `${cond.ml}: ${names} അളവ് കുറയ്ക്കാൻ ശ്രദ്ധിക്കുക.`
                : `${cond.en}: Keep portions of ${names} controlled.`
            );
          }
        });

        if (warnings.length > 0) {
          body.textContent = warnings.join(' ');
          box.classList.remove('hidden');
        } else {
          box.classList.add('hidden');
        }
      }


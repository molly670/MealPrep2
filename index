        const newDish = {
          id: 'cdish_' + Date.now(),
          name: nameVal,
          dietType: dietChoice === 'nonveg' ? 'nonveg' : 'veg',
          hasDairy: dietChoice === 'dairy',
          mealTime,
          ingredients: ingredientsList,
          steps: stepsList
        };

        if (newDish.dietType === 'nonveg') state.dietMode = 'nonveg';
        if (newDish.hasDairy) state.includeDairy = true;

        state.customDishes.unshift(newDish);
        persist();

        document.getElementById('cdNameInput').value = '';
        document.getElementById('cdIngredientsInput').value = '';
        document.getElementById('cdStepsInput').value = '';
        closeCustomDishModal();

        renderDietTogglesUI();
        renderCombos();
        renderPrepareCards();
        showSnackbar(
          state.lang === 'ml'
            ? `🍳 "${nameVal}" നിങ്ങളുടെ വിഭവങ്ങളിൽ ചേർത്തു!`
            : `🍳 Added "${nameVal}" to Meals & Prepare!`,
          'teal'
        );
      });

      document.getElementById('resetConditionsBtn').addEventListener('click', () => {
        state.selectedConditions = [];
        state.customConditions = [];
        persist();
        renderHealthConditions();
        updateKitchenHealthAdvisory();
      });

      document.getElementById('openFtueBtn').addEventListener('click', () => openFtue(0));
      document.getElementById('ftueSkipTurnOffBtn').addEventListener('click', () => closeFtue(true));
      document.getElementById('ftueBackBtn').addEventListener('click', () => {
        if (ftueStep > 0) { ftueStep--; renderFtueStep(); }
      });
      document.getElementById('ftueNextBtn').addEventListener('click', () => {
        if (ftueStep < 4) { ftueStep++; renderFtueStep(); }
        else { closeFtue(false); }
      });

      document.querySelectorAll('[data-toggle-cat-add]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-toggle-cat-add');
          const form = document.querySelector(`[data-cat-add-form="${cat}"]`);
          if (!form) return;
          form.classList.toggle('hidden');
          if (!form.classList.contains('hidden')) form.querySelector('input').focus();
        });
      });

      document.querySelectorAll('[data-cat-add-form]').forEach((form) => {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const fallbackCat = form.getAttribute('data-cat-add-form');
          const inp = form.querySelector('input');
          const rawName = inp.value.trim();
          if (!rawName) return;

          const resolved = resolveDesiIngredient(rawName, fallbackCat);
          const useMl = state.lang === 'ml';

          if (state.dietMode === 'veg' && resolved.dietType === 'nonveg') {
            const msg = useMl
              ? `🌿 നിങ്ങൾ ഇപ്പോൾ "Pure Veg" മോഡിലാണ്! "${rawName}" ഒരു നോൺ-വെജ് വിഭവമായതിനാൽ ചേർക്കാൻ കഴിയില്ല. ദയവായി മുകളിൽ "Non-Veg" തിരഞ്ഞെടുക്കൂ 😊`
              : `🌿 You're currently in Pure Veg mode, so "${rawName}" (Non-Veg) can't be added right now. Switch to Non-Veg mode to add it! 😊`;
            const switchLbl = useMl ? '🍗 Non-Veg ആക്കുക' : '🍗 Switch to Non-Veg';
            showDietGuardrailReminder(msg, switchLbl, () => setDietMode('nonveg'));
            return;
          }

          if (!state.includeDairy && resolved.isDairy) {
            const msg = useMl
              ? `🥛 നിങ്ങൾ "Dairy: OFF" ആക്കി വെച്ചിരിക്കുകയാണ്! "${rawName}" ഒരു പാലുൽപ്പന്നമായതിനാൽ ചേർക്കാൻ കഴിയില്ല. ദയവായി "Dairy" ഓൺ ചെയ്യൂ 😊`
              : `🥛 Dairy products are currently toggled OFF, so "${rawName}" can't be added. Turn Dairy ON first! 😊`;
            const switchLbl = useMl ? '🥛 Dairy ഓൺ ചെയ്യുക' : '🥛 Turn Dairy ON';
            showDietGuardrailReminder(msg, switchLbl, () => toggleDairyPreference());
            return;
          }

          hideDietGuardrailReminder();

          if (resolved.converted && resolved.targetId) {
            if (!state.selectedIngredients.includes(resolved.targetId)) {
              state.selectedIngredients.push(resolved.targetId);
            }
            const existsAlias = state.customItems.some((c) => c.name.toLowerCase() === resolved.displayLabel.toLowerCase());
            if (!existsAlias) {
              const aliasId = 'desi_' + Date.now();
              state.customItems.push({
                id: aliasId,
                name: resolved.displayLabel,
                category: resolved.category,
                icon: resolved.icon,
                dietType: resolved.dietType,
                isDairy: resolved.isDairy
              });
              state.selectedIngredients.push(aliasId);
            }

            inp.value = '';
            form.classList.add('hidden');
            persist();
            renderDietTogglesUI();
            renderFridgeChips();
            renderCombos();
            renderPrepareCards();

            showSnackbar(
              useMl
                ? `🔄 "${rawName}" → "${resolved.canonical}" ആയി മാറ്റി എല്ലാ വിഭവങ്ങളിലും ചേർത്തു!`
                : `🔄 Converted "${rawName}" → "${resolved.canonical}" & applied across Meals, Prepare & Diet!`,
              'teal'
            );
            return;
          }

          const id = 'custom_' + Date.now();
          state.customItems.push({
            id,
            name: resolved.canonical,
            category: resolved.category,
            icon: resolved.icon,
            dietType: resolved.dietType,
            isDairy: resolved.isDairy
          });
          state.selectedIngredients.push(id);
          inp.value = '';
          form.classList.add('hidden');
          persist();
          renderDietTogglesUI();
          renderFridgeChips();
          renderCombos();
          renderPrepareCards();
          showSnackbar(
            useMl
              ? `"${resolved.canonical}" ചേർത്തു!`
              : `Added "${resolved.canonical}" across Kitchen, Meals & Prepare!`,
            'teal'
          );
        });
      });

      document.getElementById('clearAllItemsBtn').addEventListener('click', () => {
        state.selectedIngredients = [];
        persist();
        renderFridgeChips();
      });

      document.getElementById('kitchenGoDietBtn').addEventListener('click', () => switchTab('diet'));
      document.getElementById('editFridgeBtn').addEventListener('click', () => switchTab('fridge'));
      document.getElementById('generatePlanBtn').addEventListener('click', () => switchTab('combo'));

      document.querySelectorAll('.nav-tab').forEach((btn) => {
        btn.addEventListener('click', () => switchTab(btn.getAttribute('data-tab')));
      });

      document.getElementById('customConditionForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const inp = document.getElementById('customConditionInput');
        const errBox = document.getElementById('customConditionError');
        const errTxt = document.getElementById('customConditionErrorText');
        const val = inp.value.trim();

        const check = validateHealthConditionInput(val);
        if (!check.valid) {
          errTxt.textContent = check.error;
          errBox.classList.remove('hidden');
          inp.classList.add('border-rose-500', 'bg-rose-50/40');
          showSnackbar(check.error, 'rose');
          return;
        }

        errBox.classList.add('hidden');
        inp.classList.remove('border-rose-500', 'bg-rose-50/40');
        state.customConditions.push(check.normalizedName);
        inp.value = '';
        persist();
        renderHealthConditions();
        showSnackbar(
          state.lang === 'ml'
            ? `🩺 "${check.normalizedName}" ചേർത്തു!`
            : `🩺 Added "${check.normalizedName}" to your health profile!`,
          'teal'
        );
      });

      document.getElementById('dismissConditionErrorBtn').addEventListener('click', () => {
        document.getElementById('customConditionError').classList.add('hidden');
        document.getElementById('customConditionInput').classList.remove('border-rose-500', 'bg-rose-50/40');
      });

      document.getElementById('customConditionInput').addEventListener('input', () => {
        document.getElementById('customConditionError').classList.add('hidden');
        document.getElementById('customConditionInput').classList.remove('border-rose-500', 'bg-rose-50/40');
      });

      document.getElementById('weightInput').addEventListener('input', calculateDietMetrics);
      document.getElementById('heightInput').addEventListener('input', calculateDietMetrics);
      document.getElementById('goalSelect').addEventListener('change', calculateDietMetrics);

      document.getElementById('groceryForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const inp = document.getElementById('groceryInput');
        const val = inp.value.trim();
        if (!val) return;
        state.groceries.unshift({ text: val, done: false });
        inp.value = '';
        persist();
        renderGroceryList();
      });

      document.getElementById('shareWhatsappBtn').addEventListener('click', (e) => {
        const message = buildWhatsappShareMessage();
        const encoded = encodeURIComponent(message);
        const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

        if (isMobile) {
          window.location.href = `whatsapp://send?text=${encoded}`;
          setTimeout(() => {
            if (!document.hidden) {
              window.location.href = `https://api.whatsapp.com/send?text=${encoded}`;
            }
          }, 900);
          e.preventDefault();
        } else {
          e.preventDefault();
          window.open(`https://api.whatsapp.com/send?text=${encoded}`, '_blank', 'noopener,noreferrer');
        }
      });

      document.getElementById('shareNativeBtn').addEventListener('click', async () => {
        const message = buildWhatsappShareMessage();
        if (navigator.share) {
          try {
            await navigator.share({
              title: 'MealPrep Grocery List',
              text: message
            });
          } catch (err) {}
        } else if (navigator.clipboard) {
          await navigator.clipboard.writeText(message);
          showSnackbar(
            state.lang === 'ml'
              ? '📋 ലിസ്റ്റ് കോപ്പി ചെയ്തു! ഇനി WhatsApp-ൽ പേസ്റ്റ് ചെയ്യാം.'
              : '📋 Grocery list copied! Paste it into WhatsApp or any app.',
            'teal'
          );
        }
      });

      // INIT
      document.getElementById('weightInput').value = state.weight;
      document.getElementById('heightInput').value = state.height;
      document.getElementById('goalSelect').value = state.goal;
      applyLanguage();
      switchTab(state.activeTab);

      if (!state.ftueDisabled) {
        openFtue(0);
      }
    })();
  </script>
</body>
</html>

      // DESI / REGIONAL NAME CONVERTER ENGINE
      function resolveDesiIngredient(rawName, fallbackCategory) {
        const cleaned = rawName.trim().replace(/\s+/g, ' ');
        const lower = cleaned.toLowerCase();

        const matchedSynonym = DESI_SYNONYMS_MAP.find((entry) =>
          entry.aliases.some((alias) => lower === alias || lower.includes(alias))
        );

        if (matchedSynonym) {
          return {
            converted: true,
            targetId: matchedSynonym.targetId,
            canonical: matchedSynonym.canonical,
            category: matchedSynonym.category,
            icon: matchedSynonym.icon,
            dietType: matchedSynonym.dietType,
            isDairy: matchedSynonym.isDairy,
            displayLabel: `${cleaned} → ${matchedSynonym.canonical}`
          };
        }

        const isNonVegWord = /(chicken|mutton|beef|pork|fish|prawn|shrimp|crab|egg|meat|kozhi|meen|mutta|murgh)/i.test(lower);
        const isDairyWord = /(milk|curd|paneer|cheese|butter|ghee|yogurt|dahi|thairu|cream)/i.test(lower);
        const icons = { grains: '🌾', protein: isNonVegWord ? '🍗' : isDairyWord ? '🥛' : '🍲', veg: '🥗' };

        return {
          converted: false,
          targetId: null,
          canonical: cleaned.replace(/\b\w/g, (ch) => ch.toUpperCase()),
          category: isNonVegWord || isDairyWord ? 'protein' : fallbackCategory,
          icon: icons[fallbackCategory] || '🥗',
          dietType: isNonVegWord ? 'nonveg' : 'veg',
          isDairy: isDairyWord,
          displayLabel: cleaned
        };
      }


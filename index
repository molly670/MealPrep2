      function calculateDietMetrics() {
        const t = tObj();
        const w = Math.max(30, Math.min(200, parseFloat(document.getElementById('weightInput').value) || 70));
        const h = Math.max(120, Math.min(220, parseFloat(document.getElementById('heightInput').value) || 170));
        const goal = document.getElementById('goalSelect').value;

        state.weight = w;
        state.height = h;
        state.goal = goal;
        persist();

        const hm = h / 100;
        const bmi = w / (hm * hm);
        let cal = Math.round(w * 30);
        if (goal === 'loss') cal -= 350;
        if (goal === 'muscle') cal += 300;
        const pro = Math.round(w * (goal === 'muscle' ? 1.4 : goal === 'loss' ? 1.2 : 1.0));

        document.getElementById('bmiResult').textContent = bmi.toFixed(1);
        const st = document.getElementById('bmiStatus');
        if (bmi < 18.5) {
          st.textContent = t.bmiUnder;
          st.className = 'text-[10px] font-extrabold text-sky-700 uppercase';
        } else if (bmi <= 24.9) {
          st.textContent = t.bmiNormal;
          st.className = 'text-[10px] font-extrabold text-emerald-700 uppercase';
        } else {
          st.textContent = t.bmiOver;
          st.className = 'text-[10px] font-extrabold text-amber-700 uppercase';
        }

        document.getElementById('calResult').textContent = cal.toLocaleString();
        document.getElementById('proResult').textContent = `${pro}g`;
      }

